---
import { and, eq } from "drizzle-orm";
import ReflectionTabs from "../../../components/ReflectionTabs.astro";
import RewardHero from "../../../components/RewardHero.astro";
import RewardItemList from "../../../components/RewardItemList.astro";
import { getCampaignById, getDoaTemplateById } from "../../../lib/admin/campaigns";
import { requireAdminOrRedirect } from "../../../lib/admin/guard";
import { db } from "../../../lib/db";
import { doaTemplates, type RewardCampaignLocale } from "../../../lib/schema";

// Token desain + font agar komponen publik dirender dengan gaya yang sama.
import "@fontsource/plus-jakarta-sans/latin-400.css";
import "@fontsource/plus-jakarta-sans/latin-600.css";
import "@fontsource/plus-jakarta-sans/latin-700.css";
import "../../../styles/tokens.css";

// Route on-demand — guard cookie per-request.
export const prerender = false;

const admin = await requireAdminOrRedirect(Astro);
if (!admin) return Astro.redirect("/admin/login");

const id = Astro.params.id ?? "";
const data = await getCampaignById(id);
if (!data) return new Response(null, { status: 404 });

const { campaign } = data;
const localeRow = data.locales.find((l) => l.locale === "id") ?? null;
const rawItems = (localeRow?.rewardItems ?? []) as Array<{
  name: string;
  benefit: string;
  format?: string | null;
  size?: string | null;
}>;
const items = rawItems.map((it) => ({
  name: it.name,
  benefit: it.benefit,
  format: it.format ?? undefined,
  size: it.size ?? undefined,
}));

const statusLabel: Record<string, string> = {
  draft: "Draft",
  published: "Published",
  paused: "Paused",
  archived: "Archived",
};

// Kelengkapan konten EN untuk badge status — pola dari broadcast composer
// (email-campaigns/[id].astro): tampil bila konten EN belum lengkap.
const enRow = data.locales.find((l) => l.locale === "en") as RewardCampaignLocale | null;
const enComplete = Boolean(enRow?.title?.trim() && enRow?.description?.trim());

// Teks doa dari pilihan preset (apa pun status campaign). `data` dilewatkan
// sebagai argumen agar TS memakai tipe yang sudah dipersempit (non-null).
async function doaContent(
  d: Exclude<Awaited<ReturnType<typeof getCampaignById>>, null>,
  variant: "muslim" | "universal",
): Promise<string> {
  const sel = d.doaSelections.find((s) => s.variant === variant);
  if (!sel) return "";
  const tpl = await getDoaTemplateById(sel.templateId);
  if (!tpl) return "";
  if (tpl.locale === "id") return tpl.content;
  const [alt] = await db
    .select()
    .from(doaTemplates)
    .where(and(eq(doaTemplates.variant, variant), eq(doaTemplates.locale, "id"), eq(doaTemplates.name, tpl.name)));
  return alt?.content ?? tpl.content;
}
const muslimText = await doaContent(data, "muslim");
const universalText = await doaContent(data, "universal");
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Preview — {localeRow?.title ?? campaign.slug}</title>
  </head>
  <body style="margin: 0; font-family: var(--font-sans, sans-serif); background: var(--color-canvas); color: var(--color-text);">
    <style>
      .fallback-badge {
        background: var(--color-warning-subtle);
        color: var(--color-warning);
        font-size: var(--text-body-sm);
        font-weight: var(--font-weight-semibold);
        border-radius: var(--radius-pill);
        padding: 4px 10px;
        display: inline-block;
        margin: var(--space-4) 0 0;
      }
    </style>
    <p
      role="status"
      style="background: var(--color-warning-subtle); color: var(--color-warning); margin: 0; padding: var(--space-3) var(--space-5); font-size: var(--text-body-sm); font-weight: var(--font-weight-semibold);"
    >
      Preview admin — status: {statusLabel[campaign.status] ?? campaign.status}
    </p>
    <main style="max-width: var(--funnel-content); margin: 0 auto; padding: var(--space-5);">
      {!enComplete && (
        <p class="fallback-badge" role="status">EN belum lengkap — fallback ID</p>
      )}
      {localeRow ? (
        <>
          <RewardHero
            overline="KADO DARI KELASWFA"
            title={localeRow.title}
            description={localeRow.description}
            imageKey={campaign.featuredImageKey}
          />
          <RewardItemList items={items} locale={localeRow.locale === "en" ? "en" : "id"} />
          <ReflectionTabs muslimText={muslimText} universalText={universalText} locale="id" />
        </>
      ) : (
        <p style="margin-top: var(--space-12); color: var(--color-text-muted);">
          Konten belum diisi. Buka editor untuk melengkapi judul dan deskripsi.
        </p>
      )}
    </main>
  </body>
</html>
