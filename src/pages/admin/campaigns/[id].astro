---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getCampaignById } from "../../../lib/admin/campaigns";
import { listGroupedDoaTemplates } from "../../../lib/admin/doa";
import { requireAdminOrRedirect } from "../../../lib/admin/guard";

// Route on-demand — guard cookie + data per-request.
export const prerender = false;

const admin = await requireAdminOrRedirect(Astro);
if (!admin) return Astro.redirect("/admin/login");

const id = Astro.params.id ?? "";
const data = await getCampaignById(id);
if (!data) return new Response(null, { status: 404 });

const { campaign } = data;
const idRow = data.locales.find((l) => l.locale === "id") ?? null;
const enRow = data.locales.find((l) => l.locale === "en") ?? null;

const statusLabel: Record<string, string> = {
  draft: "Draft",
  published: "Published",
  paused: "Paused",
  archived: "Archived",
};

function fmtDateTime(d: Date | null): string {
  if (!d) return "—";
  return new Intl.DateTimeFormat("id-ID", {
    day: "numeric",
    month: "short",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  }).format(d);
}

function fmtBytes(n: number): string {
  if (n >= 1024 * 1024) return `${(n / (1024 * 1024)).toFixed(1)} MB`;
  if (n >= 1024) return `${(n / 1024).toFixed(0)} KB`;
  return `${n} B`;
}

type Item = { name: string; benefit: string; format?: string | null; size?: string | null };
function itemsOf(row: typeof idRow): Item[] {
  if (!row || !Array.isArray(row.rewardItems)) return [];
  return row.rewardItems as Item[];
}
const idItems = itemsOf(idRow);
const enItems = itemsOf(enRow);

const assetCount = data.assets.length;
const canPublishBase = Boolean(idRow?.title && idRow?.description) && assetCount >= 1;

// Preset doa dikelompokkan per variant (berpasangan ID + EN).
const groupedTemplates = await listGroupedDoaTemplates();
const muslimGroups = groupedTemplates.filter((g) => g.variant === "muslim");
const universalGroups = groupedTemplates.filter((g) => g.variant === "universal");
const selectedMuslim = data.doaSelections.find((s) => s.variant === "muslim")?.templateId ?? null;
const selectedUniversal = data.doaSelections.find((s) => s.variant === "universal")?.templateId ?? null;

function excerpt(text: string, max = 80): string {
  const flat = text.replace(/\s+/g, " ").trim();
  return flat.length > max ? `${flat.slice(0, max)}…` : flat;
}
---
<AdminLayout title={`Edit ${campaign.slug}`} admin={admin}>
  <div class="page-head">
    <div>
      <p class="overline">Reward Campaign</p>
      <h1>{idRow?.title || campaign.slug}</h1>
      <p class="helper">
        Status: <strong>{statusLabel[campaign.status] ?? campaign.status}</strong> ·
        /{campaign.slug} · Dibuat {fmtDateTime(campaign.createdAt)}
      </p>
    </div>
    <div class="save-area">
      <span id="save-status" role="status" aria-live="polite"></span>
      <button type="button" id="save-btn" class={campaign.status === "draft" ? "btn-secondary" : "btn-primary"}>Simpan</button>
      <a href={`/admin/preview/${campaign.id}`} class="btn-secondary">Preview</a>
    </div>
  </div>

  <p id="global-error" class="error" role="alert" hidden></p>

  <form id="editor-form" data-campaign={campaign.id}>
    <!-- SECTION: Detail -->
    <section class="card" aria-labelledby="h-detail">
      <h2 id="h-detail">Detail</h2>
      <div class="grid-2">
        <div class="field">
          <label for="f-slug">Slug <span class="wajib">Wajib</span></label>
          <input id="f-slug" type="text" value={campaign.slug} spellcheck="false" autocomplete="off" aria-describedby="slug-error slug-hint" />
          <p id="slug-hint" class="hint">Alamat publik: /r/{campaign.slug}</p>
          <p id="slug-error" class="field-error" hidden></p>
        </div>
        <div class="field">
          <label for="f-order">Urutan tampil</label>
          <input id="f-order" type="number" value={campaign.sortOrder} min="0" step="1" />
        </div>
        <div class="field field-featured-image">
          <label id="featured-image-label">Banner / Featured Image</label>
          <input id="f-image" type="hidden" value={campaign.featuredImageKey ?? ""} />

          <!-- Tampilan jika sudah ada gambar terpasang -->
          <div
            id="image-preview-card"
            class="image-preview-card"
            style={!campaign.featuredImageKey ? "display: none;" : ""}
            hidden={!campaign.featuredImageKey}
          >
            <div class="image-preview-wrapper">
              <img
                id="image-preview-img"
                src={campaign.featuredImageKey ? `/admin/api/campaigns/${campaign.id}/image` : ""}
                alt="Banner Campaign"
                loading="lazy"
              />
            </div>
            <div class="image-preview-actions">
              <button type="button" id="btn-change-image" class="btn-secondary btn-small">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" width="16" height="16" aria-hidden="true"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 21h5v-5"/></svg>
                Ganti Gambar
              </button>
              <button type="button" id="btn-delete-image" class="btn-ghost-danger btn-small">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" width="16" height="16" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                Hapus Gambar
              </button>
            </div>
          </div>

          <!-- Tampilan dropzone jika belum ada gambar -->
          <div
            id="image-dropzone"
            class="image-dropzone"
            role="button"
            tabindex="0"
            aria-labelledby="featured-image-label"
            style={campaign.featuredImageKey ? "display: none;" : ""}
            hidden={Boolean(campaign.featuredImageKey)}
          >
            <div class="dropzone-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" width="28" height="28">
                <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
                <circle cx="9" cy="9" r="2"/>
                <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
              </svg>
            </div>
            <div class="dropzone-text">
              <strong>Pilih atau tarik banner gambar ke sini</strong>
              <span>Format: PNG, JPG, WebP · Maksimal 5 MB · Rasio optimal 16:9</span>
            </div>
          </div>

          <input id="image-file-input" type="file" accept="image/png,image/jpeg,image/webp" hidden />

          <!-- Indikator progress saat upload -->
          <div id="image-upload-progress" class="upload-progress" style="display: none;" hidden>
            <div class="progress-track" aria-hidden="true">
              <div id="image-progress-bar" class="progress-bar" style="width: 100%;"></div>
            </div>
            <span class="hint">Mengunggah gambar ke storage…</span>
          </div>

          <p id="image-error" class="field-error" style="display: none;" hidden></p>
        </div>
        <div class="field field-check">
          <input id="f-indexable" type="checkbox" checked={campaign.indexable} />
          <label for="f-indexable">Izinkan mesin pencari mengindeks halaman (indexable)</label>
        </div>
      </div>
    </section>

    <!-- SECTION: Konten ID -->
    <section class="card" aria-labelledby="h-id">
      <h2 id="h-id">Konten ID</h2>
      <div class="field">
        <label for="f-title-id">Judul <span class="wajib">Wajib</span></label>
        <input id="f-title-id" type="text" value={idRow?.title ?? ""} lang="id" aria-describedby="title-id-error" />
        <p id="title-id-error" class="field-error" hidden></p>
      </div>
      <div class="field">
        <label for="f-desc-id">Deskripsi <span class="wajib">Wajib</span></label>
        <textarea id="f-desc-id" rows="4" lang="id">{idRow?.description ?? ""}</textarea>
      </div>

      <fieldset class="items">
        <legend>Daftar item reward</legend>
        <p class="hint">Nama dan manfaat singkat setiap item yang diterima subscriber.</p>
        <div id="items-id" class="items-list" data-locale="id">
          {idItems.map((it, idx) => (
            <div class="item-card item-row">
              <div class="item-card-header">
                <span class="item-badge">Item <span class="item-num">{idx + 1}</span></span>
                <button type="button" class="item-remove btn-ghost-danger" aria-label="Hapus item">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                    <path d="M3 6h18m-2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                  </svg>
                  Hapus
                </button>
              </div>
              <div class="item-card-grid">
                <div class="field">
                  <label class="item-field-label">Nama item <span class="wajib">Wajib</span></label>
                  <input type="text" class="it-name" value={it.name} placeholder="Contoh: Template Spreadsheet Budget" aria-label="Nama item (ID)" lang="id" />
                </div>
                <div class="field">
                  <label class="item-field-label">Manfaat singkat <span class="wajib">Wajib</span></label>
                  <input type="text" class="it-benefit" value={it.benefit} placeholder="Contoh: Otomatis menghitung cashflow bulanan" aria-label="Manfaat item (ID)" lang="id" />
                </div>
                <div class="field">
                  <label class="item-field-label">Format <span class="opsional">(Opsional)</span></label>
                  <input type="text" class="it-format" value={it.format ?? ""} placeholder="Contoh: XLSX / PDF / Notion" aria-label="Format item (ID)" />
                </div>
                <div class="field">
                  <label class="item-field-label">Ukuran <span class="opsional">(Opsional)</span></label>
                  <input type="text" class="it-size" value={it.size ?? ""} placeholder="Contoh: 2.5 MB / 15 Halaman" aria-label="Ukuran item (ID)" />
                </div>
              </div>
            </div>
          ))}
        </div>
        <button type="button" id="add-item-id" class="btn-secondary btn-small btn-add-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
            <path d="M12 5v14m-7-7h14" />
          </svg>
          Tambah item
        </button>
      </fieldset>
    </section>

    <!-- SECTION: Content EN -->
    <section class="card" aria-labelledby="h-en">
      <div class="card-head">
        <h2 id="h-en">Content EN</h2>
        <span id="en-fallback" class="fallback-badge" role="status" aria-live="polite" hidden>EN kosong — fallback ID</span>
      </div>
      <div class="field">
        <label for="f-title-en">Title</label>
        <input id="f-title-en" type="text" value={enRow?.title ?? ""} lang="en" />
      </div>
      <div class="field">
        <label for="f-desc-en">Description</label>
        <textarea id="f-desc-en" rows="4" lang="en">{enRow?.description ?? ""}</textarea>
      </div>

      <fieldset class="items">
        <legend>Reward items</legend>
        <p class="hint">Name and brief benefit of each item received by subscribers.</p>
        <div id="items-en" class="items-list" data-locale="en">
          {enItems.map((it, idx) => (
            <div class="item-card item-row">
              <div class="item-card-header">
                <span class="item-badge">Item <span class="item-num">{idx + 1}</span></span>
                <button type="button" class="item-remove btn-ghost-danger" aria-label="Remove item">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                    <path d="M3 6h18m-2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                  </svg>
                  Hapus
                </button>
              </div>
              <div class="item-card-grid">
                <div class="field">
                  <label class="item-field-label">Item name</label>
                  <input type="text" class="it-name" value={it.name} placeholder="e.g. Budget Spreadsheet Template" aria-label="Item name (EN)" lang="en" />
                </div>
                <div class="field">
                  <label class="item-field-label">Short benefit</label>
                  <input type="text" class="it-benefit" value={it.benefit} placeholder="e.g. Automatically track monthly cashflow" aria-label="Item benefit (EN)" lang="en" />
                </div>
                <div class="field">
                  <label class="item-field-label">Format <span class="opsional">(Optional)</span></label>
                  <input type="text" class="it-format" value={it.format ?? ""} placeholder="e.g. XLSX / PDF / Notion" aria-label="Item format (EN)" />
                </div>
                <div class="field">
                  <label class="item-field-label">Size <span class="opsional">(Optional)</span></label>
                  <input type="text" class="it-size" value={it.size ?? ""} placeholder="e.g. 2.5 MB / 15 Pages" aria-label="Item size (EN)" />
                </div>
              </div>
            </div>
          ))}
        </div>
        <button type="button" id="add-item-en" class="btn-secondary btn-small btn-add-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
            <path d="M12 5v14m-7-7h14" />
          </svg>
          Tambah item
        </button>
      </fieldset>
    </section>

    <!-- SECTION: Reward files -->
    <section class="card" aria-labelledby="h-files">
      <h2 id="h-files">Reward files</h2>
      <p class="hint" id="files-format-hint">Format: PDF, ZIP, DOCX, XLSX, PPTX, PNG, JPG, WebP · maksimal 100 MB</p>

      <div
        id="dropzone"
        class="dropzone"
        role="button"
        tabindex="0"
        aria-label="Unggah file reward: tarik dan letakkan file, atau klik untuk memilih"
        aria-describedby="files-format-hint"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" width="28" height="28" aria-hidden="true">
          <path d="M12 16V4m0 0 4 4m-4-4L8 8" />
          <path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3" />
        </svg>
        <p>Tarik &amp; letakkan file di sini, atau <strong>klik untuk memilih file</strong></p>
      </div>
      <input id="asset-input" type="file" accept=".pdf,.zip,.docx,.xlsx,.pptx,.png,.jpg,.jpeg,.webp" hidden />

      <div id="upload-progress" class="upload-progress" hidden>
        <div class="progress-track" aria-hidden="true">
          <div id="progress-bar" class="progress-bar"></div>
        </div>
        <span id="progress-label" class="hint">0%</span>
      </div>

      <p id="asset-error" class="field-error" hidden></p>
      <p id="asset-status" class="hint" role="status" aria-live="polite"></p>

      <p id="asset-empty" class="placeholder" hidden={assetCount > 0}>
        Belum ada file reward. Unggah minimal satu file sebelum mempublikasikan.
      </p>
      <ul
        id="asset-list"
        class="asset-list"
        data-assets={JSON.stringify(
          data.assets.map((a) => ({
            id: a.id, nameId: a.nameId, mimeType: a.mimeType, sizeBytes: a.sizeBytes, sortOrder: a.sortOrder,
          })),
        )}
      >
        {data.assets.map((a, i) => (
          <li class="asset-row" data-id={a.id}>
            <div class="asset-info">
              <strong>{a.nameId}</strong>
              <span>{a.mimeType} · {fmtBytes(a.sizeBytes)}</span>
            </div>
            <div class="asset-actions">
              <button type="button" class="btn-secondary btn-small asset-up" aria-label={`Naikkan urutan ${a.nameId}`} disabled={i === 0}>↑</button>
              <button type="button" class="btn-secondary btn-small asset-down" aria-label={`Turunkan urutan ${a.nameId}`} disabled={i === data.assets.length - 1}>↓</button>
              <button type="button" class="btn-ghost-danger asset-delete">Hapus</button>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- SECTION: Doa -->
    <section class="card" aria-labelledby="h-doa">
      <div class="card-head">
        <h2 id="h-doa">Doa</h2>
        <a href="/admin/doa" class="btn-ghost" target="_blank" rel="noopener noreferrer">Kelola Preset ↗</a>
      </div>
      <p class="hint">
        Pilih satu preset untuk setiap bagian refleksi. Teks doa tampil di tab
        “Doa Muslim” dan “Harapan Baik” pada halaman reward.
      </p>
      {muslimGroups.length === 0 && universalGroups.length === 0 ? (
        <div class="empty-doa-box">
          <p class="placeholder">Belum ada preset doa di database. Anda dapat memuat preset bawaan atau menambah preset secara kustom.</p>
          <div class="empty-doa-actions">
            <button type="button" id="btn-quick-seed-doa" class="btn-primary btn-small">Muat Preset Doa Bawaan</button>
            <a href="/admin/doa" class="btn-secondary btn-small" target="_blank" rel="noopener noreferrer">Kelola Preset Doa ↗</a>
          </div>
          <p id="quick-seed-status" class="hint" role="status" aria-live="polite" hidden></p>
        </div>
      ) : (
        <>
          <fieldset class="doa-group">
            <legend>Doa Muslim</legend>
            {muslimGroups.map((g) => {
              const primaryId = g.idTemplate?.id ?? g.enTemplate?.id ?? "";
              const isChecked = selectedMuslim === g.idTemplate?.id || (Boolean(g.enTemplate) && selectedMuslim === g.enTemplate?.id);
              return (
                <label class="doa-option">
                  <input type="radio" name="doa-muslim" value={primaryId} checked={isChecked} />
                  <div class="doa-option-content">
                    <div class="doa-option-header">
                      <strong>{g.name}</strong>
                      {g.enTemplate ? (
                        <span class="badge-bilingual">Bilingual (ID + EN)</span>
                      ) : (
                        <span class="badge-mono">Hanya ID</span>
                      )}
                    </div>
                    {g.idTemplate && (
                      <p class="doa-preview">
                        <span class="locale-tag">ID</span>
                        <em>{excerpt(g.idTemplate.content, 95)}</em>
                      </p>
                    )}
                    {g.enTemplate && (
                      <p class="doa-preview">
                        <span class="locale-tag">EN</span>
                        <em>{excerpt(g.enTemplate.content, 95)}</em>
                      </p>
                    )}
                  </div>
                </label>
              );
            })}
          </fieldset>
          <fieldset class="doa-group">
            <legend>Harapan Baik (universal)</legend>
            {universalGroups.map((g) => {
              const primaryId = g.idTemplate?.id ?? g.enTemplate?.id ?? "";
              const isChecked = selectedUniversal === g.idTemplate?.id || (Boolean(g.enTemplate) && selectedUniversal === g.enTemplate?.id);
              return (
                <label class="doa-option">
                  <input type="radio" name="doa-universal" value={primaryId} checked={isChecked} />
                  <div class="doa-option-content">
                    <div class="doa-option-header">
                      <strong>{g.name}</strong>
                      {g.enTemplate ? (
                        <span class="badge-bilingual">Bilingual (ID + EN)</span>
                      ) : (
                        <span class="badge-mono">Hanya ID</span>
                      )}
                    </div>
                    {g.idTemplate && (
                      <p class="doa-preview">
                        <span class="locale-tag">ID</span>
                        <em>{excerpt(g.idTemplate.content, 95)}</em>
                      </p>
                    )}
                    {g.enTemplate && (
                      <p class="doa-preview">
                        <span class="locale-tag">EN</span>
                        <em>{excerpt(g.enTemplate.content, 95)}</em>
                      </p>
                    )}
                  </div>
                </label>
              );
            })}
          </fieldset>
          <p id="doa-error" class="field-error" hidden></p>
          <div class="doa-actions">
            <button type="button" id="doa-save" class="btn-secondary">Simpan pilihan doa</button>
            <span id="doa-status" role="status" aria-live="polite"></span>
          </div>
        </>
      )}
    </section>

    <!-- SECTION: SEO -->
    <section class="card" aria-labelledby="h-seo">
      <h2 id="h-seo">SEO</h2>
      <p class="hint">Kosongkan untuk memakai judul dan deskripsi konten.</p>
      <div class="grid-2">
        <div class="field">
          <label for="f-meta-title-id">Meta title (ID)</label>
          <input id="f-meta-title-id" type="text" value={idRow?.metaTitle ?? ""} lang="id" />
        </div>
        <div class="field">
          <label for="f-meta-title-en">Meta title (EN)</label>
          <input id="f-meta-title-en" type="text" value={enRow?.metaTitle ?? ""} lang="en" />
        </div>
        <div class="field">
          <label for="f-meta-desc-id">Meta description (ID)</label>
          <textarea id="f-meta-desc-id" rows="2" lang="id">{idRow?.metaDescription ?? ""}</textarea>
        </div>
        <div class="field">
          <label for="f-meta-desc-en">Meta description (EN)</label>
          <textarea id="f-meta-desc-en" rows="2" lang="en">{enRow?.metaDescription ?? ""}</textarea>
        </div>
      </div>
    </section>
  </form>

  <!-- SECTION: Publish -->
  <section class="card" aria-labelledby="h-publish">
    <h2 id="h-publish">Publish</h2>
    <p class="status-line">
      Status sekarang: <strong>{statusLabel[campaign.status] ?? campaign.status}</strong>
      {campaign.publishedAt && <span> · Dipublikasikan {fmtDateTime(campaign.publishedAt)}</span>}
    </p>
    <p id="publish-hint" class="hint" hidden>
      Untuk mempublikasikan, lengkapi judul dan deskripsi ID, serta unggah minimal 1 reward file.
    </p>
    <div class="status-actions">
      {campaign.status === "draft" && (
        <button type="button" class="btn-primary" data-status-action="publish" data-can-publish={canPublishBase ? "1" : "0"} data-asset-count={assetCount} disabled={!canPublishBase}>Publikasikan</button>
      )}
      {campaign.status === "published" && (
        <>
          <button type="button" class="btn-warning" data-status-action="pause">Jeda</button>
          <button type="button" class="btn-danger" data-status-action="archive">Arsipkan</button>
        </>
      )}
      {campaign.status === "paused" && (
        <>
          <button type="button" class="btn-primary" data-status-action="unpause">Aktifkan kembali</button>
          <button type="button" class="btn-danger" data-status-action="archive">Arsipkan</button>
        </>
      )}
      {campaign.status === "archived" && (
        <p class="hint">Campaign ini sudah diarsipkan dan tidak bisa ditayangkan kembali.</p>
      )}
      {campaign.status !== "archived" && (
        <button type="button" class="btn-secondary" data-status-action="duplicate" data-slug={campaign.slug}>Gandakan</button>
      )}
    </div>
  </section>
</AdminLayout>

<style>
  .page-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-6);
  }
  .overline {
    color: var(--color-text-muted);
