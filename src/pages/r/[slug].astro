---
import CampaignPaused from "../../components/CampaignPaused.astro";
import EmailForm from "../../components/EmailForm.astro";
import LocaleSwitch from "../../components/LocaleSwitch.astro";
import ReflectionTabs from "../../components/ReflectionTabs.astro";
import RewardHero from "../../components/RewardHero.astro";
import RewardItemList from "../../components/RewardItemList.astro";
import PublicLayout from "../../layouts/PublicLayout.astro";
import { resolveSlugRedirect } from "../../lib/admin/campaigns";
import { getPublicCampaignWithContent } from "../../lib/campaign";
import { env } from "../../lib/env";
import { t } from "../../lib/i18n";
import { notFoundResponse } from "../../lib/notfound";
import type { RewardCampaignLocale } from "../../lib/schema";

export const prerender = false;

const { slug } = Astro.params;

// Lifecycle publik: draft/archived → 404 (atau 301 ke slug terkini bila
// campaign pernah di-rename), paused → halaman ramah, published → normal.
// Satu query state + konten (task 2.4), tanpa pemanggilan kedua.
const result = await getPublicCampaignWithContent(slug!);
if (result.state === "hidden") {
  const target = await resolveSlugRedirect(slug!);
  if (target) return Astro.redirect(`/r/${target}`, 301);
  return notFoundResponse();
}
const paused = result.state === "paused";
const data = result.state === "published" ? result.data : null;
if (!paused && !data) return notFoundResponse();

// Cache publik (task 2.5 / 07-P2): halaman reward published jarang berubah;
// CDN/proxy boleh simpan 5 menit, browser 60 detik. paused/404 tidak di-cache.
if (!paused) Astro.response.headers.set("Cache-Control", "public, max-age=60, s-maxage=300");

const localeRow = (paused ? null : data!.localeRow("id").row) as RewardCampaignLocale | null;
if (!paused && !localeRow) return notFoundResponse();

const isIndexable = !paused && data!.campaign.indexable;
const items = localeRow && Array.isArray(localeRow.rewardItems) ? localeRow.rewardItems : [];

// Link alternatif bilingual: keduanya selalu ada karena /en/r/<slug> bisa
// jatuh ke konten ID (fallback) maupun EN asli.

const alternates = [
  { hreflang: "id" as const, href: `/r/${slug}` },
  { hreflang: "en" as const, href: `/en/r/${slug}` },
];

const siteUrl = env("PUBLIC_SITE_URL", new URL(Astro.request.url).origin);
---
<PublicLayout
  title={paused ? "Campaign sedang dijeda" : localeRow!.metaTitle ?? localeRow!.title}
  description={paused ? undefined : localeRow!.metaDescription ?? localeRow!.description}
  lang="id"
  noindex={!isIndexable}
  canonical={`${siteUrl}/r/${slug}`}
  alternates={alternates}
  skipTo={!paused && localeRow ? "claim-form" : undefined}
>
  <header slot="header" class="reward-header">
    <a href="/" style="color: var(--color-ink); font-weight: var(--font-weight-bold); font-size: var(--text-body-lg); text-decoration: none;">KelasWFA</a>
    <LocaleSwitch current="id" idHref={`/r/${slug}`} enHref={`/en/r/${slug}`} />
  </header>
  {paused ? (
    <CampaignPaused locale="id" />
  ) : (
    <main class="workbench-container">
      <div class="split-desk-grid">
        <section class="showcase-column">
          <RewardHero
            overline={t("id", "overline")}
            title={localeRow!.title}
            description={localeRow!.description}
            imageKey={data!.campaign.featuredImageKey}
          />
          <RewardItemList items={items} locale="id" />
          <div class="showcase-trust">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
            <span>Akses unduhan instan &amp; aman dikirim via email. Link berlaku 1 jam setelah dibuka.</span>
          </div>
        </section>
        <aside class="ritual-column">
          <div class="ritual-card">
            <ReflectionTabs
              muslimText={await data!.doaText("muslim", "id")}
              universalText={await data!.doaText("universal", "id")}
              locale="id"
            />
            <hr class="card-hairline-divider" aria-hidden="true" />
            <EmailForm slug={slug!} locale="id" campaignId={data!.campaign.id} />
          </div>
        </aside>
      </div>
    </main>
  )}
</PublicLayout>

<style>
  .workbench-container {
    max-width: var(--workbench-max);
    margin: 0 auto;
    padding: var(--space-6) var(--space-6) var(--space-12);
  }

  .split-desk-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .split-desk-grid {
      grid-template-columns: 1.15fr 1fr;
      gap: var(--space-8);
    }
  }

  .showcase-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .showcase-trust {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface-subtle);
    border: var(--border-default);
    border-radius: var(--radius-control);
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
  }

  .showcase-trust svg {
    flex-shrink: 0;
    color: var(--color-primary);
  }

  .ritual-column {
    position: relative;
  }

  @media (min-width: 1024px) {
    .ritual-column {
      position: sticky;
      top: calc(72px + var(--space-5));
    }
  }

  .ritual-card {
    background: var(--color-surface-raised);
    border: var(--border-default);
    border-radius: var(--radius-card);
    padding: var(--space-6);
    box-shadow: var(--shadow-card);
    position: relative;
  }

  .card-hairline-divider {
    height: 1px;
    background: var(--color-border);
    margin: var(--space-4) 0;
    border: none;
  }
</style>
