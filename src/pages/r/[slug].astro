---
import PublicLayout from "../../layouts/PublicLayout.astro";
import LocaleSwitch from "../../components/LocaleSwitch.astro";
import RewardHero from "../../components/RewardHero.astro";
import RewardItemList from "../../components/RewardItemList.astro";
import ReflectionTabs from "../../components/ReflectionTabs.astro";
import EmailForm from "../../components/EmailForm.astro";
import CampaignPaused from "../../components/CampaignPaused.astro";
import { getPublicCampaignState, getPublishedCampaign } from "../../lib/campaign";
import { resolveSlugRedirect } from "../../lib/admin/campaigns";
import { notFoundResponse } from "../../lib/notfound";
import { t } from "../../lib/i18n";
import { env } from "../../lib/env";
import type { RewardCampaignLocale } from "../../lib/schema";

export const prerender = false;

const { slug } = Astro.params;

// Lifecycle publik: draft/archived → 404 (atau 301 ke slug terkini bila
// campaign pernah di-rename), paused → halaman ramah, published → normal.
const state = await getPublicCampaignState(slug!);
if (state.state === "hidden") {
  const target = await resolveSlugRedirect(slug!);
  if (target) return Astro.redirect(`/r/${target}`, 301);
  return notFoundResponse();
}
const paused = state.state === "paused";
const data = paused ? null : await getPublishedCampaign(slug!);
if (!paused && !data) return notFoundResponse();

const localeRow = (paused ? null : data!.localeRow("id").row) as RewardCampaignLocale | null;
if (!paused && !localeRow) return notFoundResponse();

const isIndexable = !paused && data!.campaign.indexable;
const items = localeRow && Array.isArray(localeRow.rewardItems) ? localeRow.rewardItems : [];

// Link alternatif bilingual: keduanya selalu ada karena /en/r/<slug> bisa
// jatuh ke konten ID (fallback) maupun EN asli.

const alternates = [
  { hreflang: "id" as const, href: `/r/${slug}` },
  { hreflang: "en" as const, href: `/en/r/${slug}` },
];

const siteUrl = env("PUBLIC_SITE_URL", new URL(Astro.request.url).origin);
---
<PublicLayout
  title={paused ? "Campaign sedang dijeda" : localeRow!.metaTitle ?? localeRow!.title}
  description={paused ? undefined : localeRow!.metaDescription ?? localeRow!.description}
  lang="id"
  noindex={!isIndexable}
  canonical={`${siteUrl}/r/${slug}`}
  alternates={alternates}
>
  <header
    slot="header"
    style="display: flex; align-items: center; justify-content: space-between; height: 64px; max-width: var(--funnel-content); margin: 0 auto; padding: 0 var(--space-5); border-bottom: var(--border-default);"
  >
    <a href="/" style="color: var(--color-ink); font-weight: var(--font-weight-bold); font-size: var(--text-body-lg); text-decoration: none;">KelasWFA</a>
    <LocaleSwitch current="id" idHref={`/r/${slug}`} enHref={`/en/r/${slug}`} />
  </header>
  {paused ? (
    <CampaignPaused locale="id" />
  ) : (
    <main style="max-width: var(--funnel-content); margin: 0 auto; padding: var(--space-5);">
      <RewardHero
        overline={t("id", "overline")}
        title={localeRow!.title}
        description={localeRow!.description}
        imageKey={data!.campaign.featuredImageKey}
      />
      <RewardItemList items={items} locale="id" />
      <ReflectionTabs
        muslimText={await data!.doaText("muslim", "id")}
        universalText={await data!.doaText("universal", "id")}
        locale="id"
      />
      <EmailForm slug={slug!} locale="id" campaignId={data!.campaign.id} />
    </main>
  )}
</PublicLayout>
