---
import CampaignPaused from "../../components/CampaignPaused.astro";
import LocaleSwitch from "../../components/LocaleSwitch.astro";
import RewardClaimModal from "../../components/RewardClaimModal.astro";
import RewardHero from "../../components/RewardHero.astro";
import RewardItemList from "../../components/RewardItemList.astro";
import PublicLayout from "../../layouts/PublicLayout.astro";
import { resolveSlugRedirect } from "../../lib/admin/campaigns";
import { getPublicCampaignWithContent } from "../../lib/campaign";
import { env } from "../../lib/env";
import { t } from "../../lib/i18n";
import { notFoundResponse } from "../../lib/notfound";
import type { RewardCampaignLocale } from "../../lib/schema";

export const prerender = false;

const { slug } = Astro.params;

// Lifecycle publik: draft/archived → 404 (atau 301 ke slug terkini bila
// campaign pernah di-rename), paused → halaman ramah, published → normal.
// Satu query state + konten (task 2.4), tanpa pemanggilan kedua.
const result = await getPublicCampaignWithContent(slug!);
if (result.state === "hidden") {
  const target = await resolveSlugRedirect(slug!);
  if (target) return Astro.redirect(`/r/${target}`, 301);
  return notFoundResponse();
}
const paused = result.state === "paused";
const data = result.state === "published" ? result.data : null;
if (!paused && !data) return notFoundResponse();

// Cache publik (task 2.5 / 07-P2): halaman reward published jarang berubah;
// CDN/proxy boleh simpan 5 menit, browser 60 detik. paused/404 tidak di-cache.
if (!paused) Astro.response.headers.set("Cache-Control", "public, max-age=60, s-maxage=300");

const localeRow = (paused ? null : data!.localeRow("id").row) as RewardCampaignLocale | null;
if (!paused && !localeRow) return notFoundResponse();

const isIndexable = !paused && data!.campaign.indexable;
const items = localeRow && Array.isArray(localeRow.rewardItems) ? localeRow.rewardItems : [];

// Link alternatif bilingual: keduanya selalu ada karena /en/r/<slug> bisa
// jatuh ke konten ID (fallback) maupun EN asli.

const alternates = [
  { hreflang: "id" as const, href: `/r/${slug}` },
  { hreflang: "en" as const, href: `/en/r/${slug}` },
];

const siteUrl = env("PUBLIC_SITE_URL", new URL(Astro.request.url).origin);
---
<PublicLayout
  title={paused ? "Campaign sedang dijeda" : localeRow!.metaTitle ?? localeRow!.title}
  description={paused ? undefined : localeRow!.metaDescription ?? localeRow!.description}
  lang="id"
  noindex={!isIndexable}
  canonical={`${siteUrl}/r/${slug}`}
  alternates={alternates}
  skipTo={!paused && localeRow ? "btn-download-cta" : undefined}
>
  <header slot="header" class="reward-header">
    <a href="/" style="color: var(--color-ink); font-weight: var(--font-weight-bold); font-size: var(--text-body-lg); text-decoration: none;">KelasWFA</a>
    <LocaleSwitch current="id" idHref={`/r/${slug}`} enHref={`/en/r/${slug}`} />
  </header>
  {paused ? (
    <CampaignPaused locale="id" />
  ) : (
    <main class="showcase-container">
      <RewardHero
        overline={t("id", "overline")}
        title={localeRow!.title}
        description={localeRow!.description}
        imageKey={data!.campaign.featuredImageKey}
      />
      <RewardItemList items={items} locale="id" />
      <div class="showcase-trust">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
        <span>Akses unduhan instan &amp; aman dikirim via email. Link berlaku 1 jam setelah dibuka.</span>
      </div>

      <div class="showcase-action-box">
        <button type="button" class="btn-download-primary" id="btn-download-cta">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          <span>{t("id", "downloadCta")}</span>
        </button>
        <p class="action-subtext">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
          <span>{t("id", "downloadSubtext")}</span>
        </p>
      </div>

      <RewardClaimModal
        slug={slug!}
        locale="id"
        campaignId={data!.campaign.id}
        muslimText={await data!.doaText("muslim", "id")}
        universalText={await data!.doaText("universal", "id")}
      />
    </main>
  )}
</PublicLayout>

<style>
  .showcase-container {
    max-width: var(--showcase-max, 740px);
    margin: 0 auto;
    padding: var(--space-8) var(--space-6) var(--space-16);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .showcase-trust {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface-subtle);
    border: var(--border-default);
    border-radius: var(--radius-control);
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
  }

  .showcase-trust svg {
    flex-shrink: 0;
    color: var(--color-primary);
  }

  .showcase-action-box {
    background: var(--color-surface-raised);
    border: var(--border-default);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    padding: var(--space-6);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .btn-download-primary {
    width: 100%;
    max-width: 440px;
    background: var(--color-primary);
    color: var(--color-surface-raised);
    border: none;
    border-radius: var(--radius-control);
    padding: 16px var(--space-6);
    font-family: inherit;
    font-size: 17px;
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.01em;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    box-shadow: 0 4px 14px rgba(23, 107, 91, 0.28);
    transition: all 180ms ease;
  }

  .btn-download-primary:hover {
    background: var(--color-primary-hover);
    box-shadow: 0 6px 18px rgba(23, 107, 91, 0.35);
    transform: translateY(-1px);
  }

  .btn-download-primary:active {
    transform: translateY(0);
    box-shadow: 0 2px 8px rgba(23, 107, 91, 0.2);
  }

  .action-subtext {
    margin: 0;
    font-size: 13.5px;
    color: var(--color-text-muted);
    line-height: 1.45;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .action-subtext svg {
    color: var(--color-gold);
    flex-shrink: 0;
  }
</style>
