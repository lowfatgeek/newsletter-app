---
import CheckEmailNotice from "../components/CheckEmailNotice.astro";
import PublicLayout from "../layouts/PublicLayout.astro";
import { t } from "../lib/i18n";

export const prerender = false;

// Task 3.1 / 01-F6: dulu halaman ini membaca ?m= untuk menampilkan email yang
// disamarkan, tapi subscribe.ts tidak pernah memproduksi parameter itu
// (sengaja — tidak membawa alamat email di URL). Salinan kini statis.
const error = Astro.url.searchParams.get("e");
const errorText: Record<string, string> = {
  "bad-request": t("id", "errorGeneric"),
  "too-fast": t("id", "timerTooFast"),
  "rate-limited": t("id", "errorRate"),
  "domain-not-allowed": t("id", "errorDomain"),
  "campaign-unavailable": t("id", "errorGeneric"),
};
const isError = Boolean(error && errorText[error]);
const title = isError ? t("id", "checkEmailErrorTitle") : t("id", "checkEmailTitle");

// ?s= membawa slug campaign asal — tombol menaut kembali ke
// landing campaign; fallback "/" bila tidak ada (mis. error pre-slug).
const resendSlug = Astro.url.searchParams.get("s") ?? "";
---
<PublicLayout title={title} lang="id" noindex>
  <CheckEmailNotice
    locale="id"
    resendSlug={resendSlug}
    error={error}
    errorText={error && errorText[error] ? errorText[error] : null}
  />
</PublicLayout>
