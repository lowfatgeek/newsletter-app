---
import PublicLayout from "../layouts/PublicLayout.astro";
import { t } from "../lib/i18n";

export const prerender = false;

// Task 3.1 / 01-F6: dulu halaman ini membaca ?m= untuk menampilkan email yang
// disamarkan, tapi subscribe.ts tidak pernah memproduksi parameter itu
// (sengaja — tidak membawa alamat email di URL). Salinan kini statis.
const body = t("id", "checkEmailBody");
const error = Astro.url.searchParams.get("e");
// ?s= membawa slug campaign asal — tombol "Kirim ulang" menaut kembali ke
// landing campaign; fallback "/" bila tidak ada (mis. error pre-slug).
const resendSlug = Astro.url.searchParams.get("s") ?? "";
const resendHref = resendSlug ? `/r/${resendSlug}` : "/";
const errorText: Record<string, string> = {
  "bad-request": t("id", "errorGeneric"),
  "too-fast": t("id", "timerTooFast"),
  "rate-limited": t("id", "errorRate"),
  "domain-not-allowed": t("id", "errorDomain"),
  "campaign-unavailable": t("id", "errorGeneric"),
};
---
<PublicLayout title={t("id", "checkEmailTitle")} lang="id" noindex>
  <main style="max-width: var(--download-content); margin: 0 auto; padding: var(--space-12) var(--space-5);">
    <div style="background: var(--color-surface-raised); border: var(--border-default); border-radius: var(--radius-card); padding: var(--space-6); box-shadow: var(--shadow-card);">
      <span
        aria-hidden="true"
        style="display: inline-flex; align-items: center; justify-content: center; width: 56px; height: 56px; border-radius: var(--radius-pill); background: var(--color-primary-subtle); color: var(--color-primary); margin: 0 0 var(--space-4);"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" width="28" height="28">
          <rect x="2.5" y="4.5" width="19" height="15" rx="2.5"></rect>
          <path d="m3.4 6.4 8.6 6.3 8.6-6.3"></path>
        </svg>
      </span>
      <h1 style="color: var(--color-ink); margin: 0 0 var(--space-4);">{t("id", "checkEmailTitle")}</h1>
      <p style="color: var(--color-text-muted); line-height: 1.6; margin: 0 0 var(--space-4);">
        {body}
      </p>
      {error && errorText[error] && (
        <p style="background: var(--color-warning-subtle); color: var(--color-ink); border-radius: var(--radius-control); padding: var(--space-3); font-size: var(--text-body-sm); margin: 0 0 var(--space-4);">
          {errorText[error]}
        </p>
      )}
      <a
        href={resendHref}
        style="display: inline-flex; align-items: center; min-height: 44px; padding: 10px 20px; border: var(--border-default); border-radius: var(--radius-control); background: transparent; color: var(--color-primary); font-weight: 600; text-decoration: none;"
      >Kirim ulang</a>
    </div>
  </main>
</PublicLayout>
