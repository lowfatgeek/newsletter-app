---
import CampaignPaused from "../../../components/CampaignPaused.astro";
import EmailForm from "../../../components/EmailForm.astro";
import LocaleSwitch from "../../../components/LocaleSwitch.astro";
import ReflectionTabs from "../../../components/ReflectionTabs.astro";
import RewardHero from "../../../components/RewardHero.astro";
import RewardItemList from "../../../components/RewardItemList.astro";
import PublicLayout from "../../../layouts/PublicLayout.astro";
import { resolveSlugRedirect } from "../../../lib/admin/campaigns";
import { getPublicCampaignWithContent } from "../../../lib/campaign";
import { env } from "../../../lib/env";
import { type Locale, t } from "../../../lib/i18n";
import { notFoundResponse } from "../../../lib/notfound";
import type { RewardCampaignLocale } from "../../../lib/schema";

export const prerender = false;

const { slug } = Astro.params;

// Lifecycle publik: draft/archived → 404 (atau 301 ke slug terkini bila
// campaign pernah di-rename), paused → halaman ramah, published → normal.
// Satu query state + konten (task 2.4), tanpa pemanggilan kedua.
const result = await getPublicCampaignWithContent(slug!);
if (result.state === "hidden") {
  const target = await resolveSlugRedirect(slug!);
  if (target) return Astro.redirect(`/en/r/${target}`, 301);
  return notFoundResponse("en");
}
const paused = result.state === "paused";
const data = result.state === "published" ? result.data : null;
if (!paused && !data) return notFoundResponse("en");

// Cache publik (task 2.5 / 07-P2) — sama dengan halaman ID.
if (!paused) Astro.response.headers.set("Cache-Control", "public, max-age=60, s-maxage=300");

const localeRow = (paused ? null : data!.localeRow("en").row) as RewardCampaignLocale | null;
if (!paused && !localeRow) return notFoundResponse("en");

// Fallback eksplisit: kalau row EN kosong, konten halaman dirender memakai
// row ID — dan html lang mengikuti LOCALE KONTEN EFEKTIF (lang="id"),
// bukan URL yang diminta.
const fallbackToId = paused ? false : data!.localeRow("en").fallbackToId;
const locale: Locale = paused ? "en" : fallbackToId ? "id" : "en";
const isIndexable = !paused && data!.campaign.indexable && !fallbackToId;
const items = localeRow && Array.isArray(localeRow.rewardItems) ? localeRow.rewardItems : [];

// Link alternatif bilingual: keduanya selalu ada (versi ID di /r/<slug>,
// versi EN di /en/r/<slug>) — pada fallback EN tetap bisa ditemukan crawler.

const alternates = [
  { hreflang: "id" as const, href: `/r/${slug}` },
  { hreflang: "en" as const, href: `/en/r/${slug}` },
];

const siteUrl = env("PUBLIC_SITE_URL", new URL(Astro.request.url).origin);
---
<PublicLayout
  title={paused ? "This campaign is paused" : localeRow!.metaTitle ?? localeRow!.title}
  description={paused ? undefined : localeRow!.metaDescription ?? localeRow!.description}
  lang={locale}
  noindex={!isIndexable}
  canonical={`${siteUrl}/en/r/${slug}`}
  alternates={alternates}
  skipTo={!paused && localeRow ? "claim-form" : undefined}
>
  <header slot="header" class="reward-header">
    <a href="/" style="color: var(--color-ink); font-weight: var(--font-weight-bold); font-size: var(--text-body-lg); text-decoration: none;">KelasWFA</a>
    <LocaleSwitch current="en" idHref={`/r/${slug}`} enHref={`/en/r/${slug}`} />
  </header>
  {paused ? (
    <CampaignPaused locale="en" />
  ) : (
    <main class="workbench-container">
      <div class="split-desk-grid">
        <section class="showcase-column">
          <RewardHero
            overline={t(locale, "overline")}
            title={localeRow!.title}
            description={localeRow!.description}
            imageKey={data!.campaign.featuredImageKey}
          />
          <RewardItemList items={items} locale={locale} />
          <div class="showcase-trust">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
            <span>
              {locale === "en"
                ? "Secure and instant download link delivered to your inbox. Link valid for 1 hour."
                : "Akses unduhan instan & aman dikirim via email. Link berlaku 1 jam setelah dibuka."}
            </span>
          </div>
        </section>
        <aside class="ritual-column">
          <div class="ritual-card">
            <ReflectionTabs
              muslimText={await data!.doaText("muslim", locale)}
              universalText={await data!.doaText("universal", locale)}
              locale={locale}
            />
            <hr class="card-hairline-divider" aria-hidden="true" />
            <EmailForm slug={slug!} locale={locale} campaignId={data!.campaign.id} />
          </div>
        </aside>
      </div>
    </main>
  )}
</PublicLayout>

<style>
  .workbench-container {
    max-width: var(--workbench-max);
    margin: 0 auto;
    padding: var(--space-8) var(--space-6) var(--space-16);
  }

  .split-desk-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .split-desk-grid {
      grid-template-columns: 1.15fr 1fr;
      gap: var(--space-10);
    }
  }

  .showcase-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .showcase-trust {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface-subtle);
    border: var(--border-default);
    border-radius: var(--radius-control);
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
  }

  .showcase-trust svg {
    flex-shrink: 0;
    color: var(--color-primary);
  }

  .ritual-column {
    position: relative;
  }

  @media (min-width: 1024px) {
    .ritual-column {
      position: sticky;
      top: calc(72px + var(--space-6));
    }
  }

  .ritual-card {
    background: var(--color-surface-raised);
    border: var(--border-default);
    border-radius: var(--radius-card);
    padding: var(--space-6);
    box-shadow: var(--shadow-card);
    position: relative;
  }

  @media (min-width: 640px) {
    .ritual-card {
      padding: var(--space-8);
    }
  }

  .card-hairline-divider {
    height: 1px;
    background: var(--color-border);
    margin: var(--space-6) 0;
    border: none;
  }
</style>
