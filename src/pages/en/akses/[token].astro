---
import { eq } from "drizzle-orm";
import PublicLayout from "../../../layouts/PublicLayout.astro";
import { resolveAccess } from "../../../lib/access-page";
import { humanSize } from "../../../lib/admin/format";
import { db } from "../../../lib/db";
import { rewardAssets } from "../../../lib/schema";

export const prerender = false;

const { token } = Astro.params;
const resolved = await resolveAccess(token!);
if (!resolved.ok) return Astro.redirect("/", 303);
const { sessionToken, campaignId, content } = resolved;

// Fallback eksplisit: tanpa row EN, seluruh halaman memakai copy dan lang ID.
const { fallbackToId } = content.localeRow("en");
const locale = fallbackToId ? "id" : "en";

const assets = await db
  .select()
  .from(rewardAssets)
  .where(eq(rewardAssets.campaignId, campaignId))
  .orderBy(rewardAssets.sortOrder);
---
<PublicLayout title={locale === "en" ? "Your gift is ready" : "Kadonya siap dibuka"} lang={locale} noindex>
  <main style="max-width: var(--download-content); margin: 0 auto; padding: var(--space-12) var(--space-5);">
    <h1 style="color: var(--color-ink);">{locale === "en" ? "Your gift is ready." : "Kadonya siap dibuka."}</h1>
    <p style="color: var(--color-text-muted); margin: 0 0 var(--space-6);">
      {locale === "en" ? "Download links are valid for 1 hour." : "Link unduhan berlaku 1 jam."}
    </p>
    <ul style="list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-3);">
      {assets.map((a) => (
        <li style="background: var(--color-surface-raised); border: var(--border-default); border-radius: var(--radius-card); padding: var(--space-6); display: flex; justify-content: space-between; align-items: center; gap: var(--space-4);">
          <div>
            <strong style="color: var(--color-ink);">{locale === "en" && a.nameEn ? a.nameEn : a.nameId}</strong>
            <p style="margin: 4px 0 0; color: var(--color-text-muted); font-size: var(--text-body-sm);">{a.mimeType} · {humanSize(Number(a.sizeBytes))}</p>
          </div>
          <a href={`/api/download/${sessionToken}/${a.id}`} referrerpolicy="no-referrer" style="background: var(--color-primary); color: var(--color-surface-raised); text-decoration: none; padding: 12px 20px; border-radius: var(--radius-control); font-weight: 600; min-height: 44px; display: inline-flex; align-items: center;">{locale === "en" ? "Secure download" : "Unduh aman"}</a>
        </li>
      ))}
    </ul>
  </main>
</PublicLayout>
