---
import ExpiredNotice from "../../../components/ExpiredNotice.astro";
import PublicLayout from "../../../layouts/PublicLayout.astro";
import { confirmContactByToken, issueSessionToken } from "../../../lib/access";

export const prerender = false;

const { token } = Astro.params;
const result = await confirmContactByToken(token!);
if (result.ok) {
  const session = await issueSessionToken(result.claimId);
  return Astro.redirect(`/en/akses/${session}`, 303);
}
---
<PublicLayout title="This link has expired" lang="en" noindex>
  <ExpiredNotice locale="en" homeUrl="/" />
</PublicLayout>
