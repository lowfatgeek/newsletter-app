---
import CheckEmailNotice from "../../components/CheckEmailNotice.astro";
import PublicLayout from "../../layouts/PublicLayout.astro";
import { t } from "../../lib/i18n";

export const prerender = false;

// Task 3.1 / 01-F6: the ?m= masked-email param was never produced by
// subscribe.ts (the address is deliberately kept out of the URL), so the copy
// is static now.
const error = Astro.url.searchParams.get("e");
const errorText: Record<string, string> = {
  "bad-request": t("en", "errorGeneric"),
  "too-fast": t("en", "timerTooFast"),
  "rate-limited": t("en", "errorRate"),
  "domain-not-allowed": t("en", "errorDomain"),
  "campaign-unavailable": t("en", "errorGeneric"),
};
const isError = Boolean(error && errorText[error]);
const title = isError ? t("en", "checkEmailErrorTitle") : t("en", "checkEmailTitle");

// ?s= brings original campaign slug — button links back to landing campaign
const resendSlug = Astro.url.searchParams.get("s") ?? "";
---
<PublicLayout title={title} lang="en" noindex>
  <CheckEmailNotice
    locale="en"
    resendSlug={resendSlug}
    error={error}
    errorText={error && errorText[error] ? errorText[error] : null}
  />
</PublicLayout>
