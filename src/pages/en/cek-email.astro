---
import PublicLayout from "../../layouts/PublicLayout.astro";
import { maskedEmail } from "../../lib/templates";
import { t } from "../../lib/i18n";

export const prerender = false;

// ?m= membawa email yang akan disamarkan — masking dilakukan di server.
const raw = Astro.url.searchParams.get("m") ?? "";
const masked = raw ? maskedEmail(raw) : null;
const body = t("en", "checkEmailBody").replace("{email}", masked ?? "your email");
const error = Astro.url.searchParams.get("e");
const errorText: Record<string, string> = {
  "bad-request": t("en", "errorGeneric"),
  "too-fast": t("en", "timerTooFast"),
  "rate-limited": t("en", "errorRate"),
  "domain-not-allowed": t("en", "errorDomain"),
  "campaign-unavailable": t("en", "errorGeneric"),
};
---
<PublicLayout title={t("en", "checkEmailTitle")} lang="en" noindex>
  <main style="max-width: var(--download-content); margin: 0 auto; padding: var(--space-12) var(--space-5);">
    <div style="background: var(--color-surface-raised); border: var(--border-default); border-radius: var(--radius-card); padding: var(--space-6); box-shadow: var(--shadow-card);">
      <h1 style="color: var(--color-ink); margin: 0 0 var(--space-4);">{t("en", "checkEmailTitle")}</h1>
      <p style="color: var(--color-text-muted); line-height: 1.6; margin: 0 0 var(--space-4);">
        {body}
      </p>
      {error && errorText[error] && (
        <p style="background: var(--color-warning-subtle); color: var(--color-ink); border-radius: var(--radius-control); padding: var(--space-3); font-size: var(--text-body-sm); margin: 0 0 var(--space-4);">
          {errorText[error]}
        </p>
      )}
      <a
        href="/"
        style="display: inline-flex; align-items: center; min-height: 44px; padding: 10px 20px; border: var(--border-default); border-radius: var(--radius-control); background: transparent; color: var(--color-primary); font-weight: 600; text-decoration: none;"
      >Resend</a>
    </div>
  </main>
</PublicLayout>
