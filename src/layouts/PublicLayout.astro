---
// Plus Jakarta Sans — bobot yang benar-benar dipakai tokens.css (400/600/700),
// subset latin, font-display: swap (default @fontsource).
import "@fontsource/plus-jakarta-sans/latin-400.css";
import "@fontsource/plus-jakarta-sans/latin-600.css";
import "@fontsource/plus-jakarta-sans/latin-700.css";
import "../styles/tokens.css";
interface Props {
  title: string;
  description?: string;
  lang?: "id" | "en";
  noindex?: boolean;
  alternates?: Array<{ hreflang: "id" | "en"; href: string }>;
}
const { title, description = "", lang = "id", noindex = false, alternates = [] } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
  </head>
  <body>
    <slot />
  </body>
</html>
