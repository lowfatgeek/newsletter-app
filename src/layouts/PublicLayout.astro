---
// Plus Jakarta Sans — bobot yang benar-benar dipakai tokens.css (400/600/700),
// subset latin, font-display: swap (default @fontsource).
import "@fontsource/plus-jakarta-sans/latin-400.css";
import "@fontsource/plus-jakarta-sans/latin-600.css";
import "@fontsource/plus-jakarta-sans/latin-700.css";
import "../styles/tokens.css";
import { t } from "../lib/i18n";

interface Props {
  title: string;
  description?: string;
  lang?: "id" | "en";
  noindex?: boolean;
  canonical?: string;
  alternates?: Array<{ hreflang: "id" | "en"; href: string }>;
  // Task 2.11 / 06-A11y5: id target skip link (mis. "claim-form"). Hanya
  // dilewati bila halaman punya target — halaman status singkat tidak.
  skipTo?: string;
}
const { title, description = "", lang = "id", noindex = false, canonical, alternates = [], skipTo } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
  </head>
  <body>
    {skipTo && <a href={`#${skipTo}`} class="skip-link">{t(lang, "skipToForm")}</a>}
    <slot name="header" />
    <slot />
  </body>
</html>
