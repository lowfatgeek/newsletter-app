---
// Plus Jakarta Sans — bobot yang benar-benar dipakai tokens.css (400/600/700).
import "@fontsource/plus-jakarta-sans/latin-400.css";
import "@fontsource/plus-jakarta-sans/latin-600.css";
import "@fontsource/plus-jakarta-sans/latin-700.css";
import "../styles/tokens.css";

interface Props {
  title: string;
  admin?: { email: string } | null;
}
const { title, admin = null } = Astro.props;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} — KelasWFA Admin</title>
  </head>
  <body>
    {/* Task 3.11 / 06-A11y6: drawer navigasi mobile tanpa JS (checkbox + label).
        Input sengaja tetap fokusable (bukan `hidden`) agar bisa dibuka lewat
        keyboard dengan Space; scrim adalah label → klik di luar = tutup. */}
    <input id="admin-nav-toggle" class="admin-nav-toggle" type="checkbox" />
    {admin && <label for="admin-nav-toggle" class="admin-nav-scrim" aria-hidden="true"></label>}
    {admin && (
      <aside class="admin-sidebar" id="admin-nav">
        <strong class="admin-brand">KelasWFA Admin</strong>
        <nav class="admin-nav" aria-label="Navigasi admin">
          <a href="/admin/campaigns">Reward Campaign</a>
          <a href="/admin/email-campaigns">Email Campaign</a>
          <a href="/admin/contacts">Kontak</a>
          <a href="/admin/domains">Domain Email</a>
          <a href="/admin/audit">Audit Log</a>
        </nav>
        <form method="post" action="/admin/api/logout" class="admin-logout">
          <button type="submit">Keluar</button>
        </form>
      </aside>
    )}
    <main class={admin ? "admin-main" : "admin-auth"}>
      {admin && (
        <header class="admin-mobile-bar">
          <label for="admin-nav-toggle" class="admin-nav-burger" aria-label="Buka navigasi admin">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" aria-hidden="true">
              <path d="M4 7h16"></path>
              <path d="M4 12h16"></path>
              <path d="M4 17h16"></path>
            </svg>
          </label>
          <span class="admin-mobile-email">{admin.email}</span>
          <form method="post" action="/admin/api/logout">
            <button type="submit">Keluar</button>
          </form>
        </header>
      )}
      <slot />
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    font-family: var(--font-sans);
    background: var(--color-canvas);
    color: var(--color-text);
  }
  /* Kontrol drawer hanya relevan di mobile — di desktop checkbox dimatikan
     agar tidak bisa di-Tab ke elemen tak terlihat. */
  .admin-nav-toggle { display: none; }
  .admin-nav-burger { display: none; }
  .admin-nav-scrim {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 20;
    background: rgba(21, 59, 53, 0.45);
  }
  .admin-sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    width: 240px;
    background: var(--color-ink);
    color: var(--color-canvas);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    z-index: 30;
    overflow-y: auto;
  }
  .admin-brand { margin-bottom: var(--space-5); color: var(--color-canvas); }
  .admin-nav { display: flex; flex-direction: column; gap: var(--space-2); }
  .admin-nav a {
    color: var(--color-canvas);
    text-decoration: none;
    padding: 10px 12px;
    border-radius: var(--radius-control);
    min-height: 24px;
  }
  .admin-nav a:hover { background: rgba(255, 252, 245, 0.1); }
  .admin-logout { margin-top: auto; }
  .admin-sidebar button,
  .admin-mobile-bar button {
    background: none;
    border: 1px solid rgba(255, 252, 245, 0.3);
    color: var(--color-canvas);
    border-radius: var(--radius-control);
    padding: 10px 12px;
    min-height: 44px;
    width: 100%;
    font-family: inherit;
    cursor: pointer;
  }
  .admin-main {
    margin-left: 240px;
    padding: var(--space-8);
    max-width: calc(var(--admin-content) - 240px);
  }
  .admin-mobile-bar { display: none; }
  .admin-auth {
    padding: var(--space-8);
    max-width: var(--auth-content);
    margin: 0 auto;
  }
  /* Mobile: sidebar jadi drawer (buka lewat tombol burger, tutup via scrim). */
  @media (max-width: 1023px) {
    .admin-nav-toggle {
      display: block;
      position: absolute;
      width: 1px;
      height: 1px;
      margin: 0;
      opacity: 0;
    }
    .admin-sidebar {
      transform: translateX(-100%);
      visibility: hidden;
      transition:
        transform 200ms ease,
        visibility 200ms ease;
      box-shadow: var(--shadow-card);
    }
    .admin-nav-toggle:checked ~ .admin-sidebar {
      transform: translateX(0);
      visibility: visible;
    }
    .admin-nav-toggle:checked ~ .admin-nav-scrim { display: block; }
    .admin-nav-toggle:focus-visible ~ main .admin-nav-burger {
      outline: 2px solid var(--color-primary);
      outline-offset: 2px;
    }
    .admin-nav-burger {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: none;
      width: 44px;
      height: 44px;
      border: var(--border-default);
      border-radius: var(--radius-control);
      background: var(--color-surface-raised);
      color: var(--color-ink);
      cursor: pointer;
    }
    .admin-mobile-email {
      flex: 1;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .admin-main { margin-left: 0; max-width: none; padding: var(--space-4); }
    .admin-mobile-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      margin-bottom: var(--space-6);
      font-size: var(--text-body-sm);
      color: var(--color-text-muted);
    }
    .admin-mobile-bar form { width: auto; }
    .admin-mobile-bar button {
      width: auto;
      color: var(--color-danger);
      border-color: var(--color-danger);
      background: var(--color-canvas);
    }
  }
</style>
