---
interface Props {
  current: "id" | "en";
  idHref: string;
  enHref: string;
}
const { current, idHref, enHref } = Astro.props;

const chipStyle =
  "display: inline-flex; align-items: center; min-height: 44px; padding: 8px 16px; border-radius: var(--radius-pill); background: var(--color-primary-subtle); color: var(--color-primary); font-weight: var(--font-weight-semibold); font-size: var(--text-body-sm); text-decoration: none;";
const textStyle =
  "display: inline-flex; align-items: center; min-height: 44px; padding: 8px 4px; color: var(--color-text-muted); font-size: var(--text-body-sm); text-decoration: none;";
---
<nav aria-label="Pilih bahasa" style="display: flex; align-items: center; gap: var(--space-2);">
  {current === "id" ? (
    <span aria-current="true" style={textStyle}>ID</span>
    <a href={enHref} style={chipStyle} lang="en">EN</a>
  ) : (
    <a href={idHref} style={chipStyle} lang="id">ID</a>
    <span aria-current="true" style={textStyle}>EN</span>
  )}
</nav>
