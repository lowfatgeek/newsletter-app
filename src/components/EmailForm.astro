---
import { listActiveDomains } from "../lib/allowlist";
import { type Locale, t } from "../lib/i18n";
import { issueTimerToken } from "../lib/timer";

interface Props {
  slug: string;
  locale: Locale;
  campaignId: string;
  placeholder?: string;
}
const { slug, locale, campaignId, placeholder: customPlaceholder } = Astro.props;

// Server-rendered token: fallback tanpa JS (PRD 7.1) — tetap valid meski script gagal jalan.
// JS hanya menyegarkan token via POST /api/timer-token di awal timer.
const serverToken = issueTimerToken(campaignId);
const timerMs = import.meta.env.TEST_TIMER_MS ?? "30000";

const activeDomains = await listActiveDomains();
const placeholder = customPlaceholder ?? activeDomains.join(", ");

const copy = {
  initial: t(locale, "timerInitial"),
  done: t(locale, "timerDone"),
  ten: t(locale, "timerTenLeft"),
  tooFast: t(locale, "timerTooFast"),
  label: t(locale, "emailLabel"),
  consent: t(locale, "consentCopy"),
  consentResubscribe: t(locale, "consentResubscribe"),
  submitting: t(locale, "submittingCta"),
  privacy: t(locale, "privacyLink"),
  cta: t(locale, "submitCta"),
  errorEmail: t(locale, "errorEmailInvalid"),
  errorGeneric: t(locale, "errorGeneric"),
};
const action = "/api/subscribe";
const privacyHref = locale === "en" ? "/en/privacy" : "/privacy";
---
<form
  id="claim-form"
  method="post"
  action={action}
  data-copy={JSON.stringify(copy)}
  data-timer-ms={timerMs}
  class="claim-form"
>
  <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position: absolute; left: -9999px;" />
  <input type="hidden" name="slug" value={slug} />
  <input type="hidden" name="locale" value={locale} />
  <input type="hidden" name="timer_token" id="timer-token" value={serverToken} />

  <p
    id="timer-status"
    class="timer-panel"
    role="status"
    aria-live="polite"
  >
    <svg class="timer-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
    </svg>
    <span id="timer-status-text">{copy.initial}</span>
  </p>

  <div class="timer-track" aria-hidden="true">
    <div id="timer-bar" class="timer-bar"></div>
  </div>

  <label for="email" class="field-label">{copy.label}</label>
  <input
    id="email"
    name="email"
    type="email"
    required
    autocomplete="email"
    inputmode="email"
    placeholder={placeholder}
    aria-describedby="form-error"
    class="email-input"
  />

  <p id="form-error" class="form-error-alert" role="alert" hidden></p>

  <p class="consent-text">
    {copy.consent}{" "}<a href={privacyHref}>{copy.privacy}</a>.
  </p>

  <label class="resubscribe-label">
    <input type="checkbox" name="resubscribe_consent" value="yes" class="resubscribe-checkbox" />
    <span>{copy.consentResubscribe}</span>
  </label>

  <button
    id="submit-btn"
    type="submit"
    class="submit-cta-btn"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
    </svg>
    <span id="submit-btn-text">{copy.cta}</span>
  </button>
</form>

<script>
  const form = document.getElementById("claim-form") as HTMLFormElement;
  const statusBox = document.getElementById("timer-status") as HTMLParagraphElement;
  const statusText = (document.getElementById("timer-status-text") || statusBox) as HTMLElement;
  const bar = document.getElementById("timer-bar") as HTMLDivElement;
  const tokenInput = document.getElementById("timer-token") as HTMLInputElement;
  const btn = document.getElementById("submit-btn") as HTMLButtonElement;
  const btnText = (document.getElementById("submit-btn-text") || btn) as HTMLElement;
  const copy = JSON.parse(form.dataset.copy as string) as {
    initial: string;
    done: string;
    ten: string;
    cta: string;
    submitting: string;
    tooFast: string;
    errorEmail: string;
    errorGeneric: string;
  };
  const TOTAL = Number(form.dataset.timerMs) || 30_000;
  const TEN_LEFT = Math.max(0, TOTAL - 10_000);

  // Satu CTA per state: nonaktif (abu) selama timer, aktif (primary) setelah selesai.
  btn.disabled = true;
  btn.setAttribute("aria-disabled", "true");
  btn.classList.remove("active");
  btn.style.background = "var(--color-surface-subtle)";
  btn.style.color = "var(--color-text-muted)";
  btn.style.cursor = "not-allowed";

  let announcedTen = false;
  let unlocked = false;
  let timerStarted = false;
  let start = 0;

  const unlock = () => {
    unlocked = true;
    btn.disabled = false;
    btn.removeAttribute("aria-disabled");
    btn.classList.add("active");
    btn.style.background = "var(--color-primary)";
    btn.style.color = "var(--color-surface-raised)";
    btn.style.cursor = "pointer";
    statusBox.classList.add("unlocked");
    bar.classList.add("unlocked");
  };

  const tick = () => {
    const elapsed = Date.now() - start;
    bar.style.width = `${Math.min(100, (elapsed / TOTAL) * 100)}%`;
    // aria-live polite: umumkan hanya 10 detik terakhir dan selesai (bukan tiap detik).
    if (!announcedTen && elapsed >= TEN_LEFT && elapsed < TOTAL) {
      announcedTen = true;
      statusText.textContent = copy.ten;
    }
    if (elapsed >= TOTAL) {
      statusText.textContent = copy.done;
      unlock();
      return;
    }
    requestAnimationFrame(tick);
  };

  const startTimer = () => {
    if (timerStarted || unlocked) return;
    timerStarted = true;
    start = Date.now();

    // Segarkan token (best-effort). Kalau gagal, token server-rendered tetap dipakai.
    fetch("/api/timer-token", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ slug: (form.querySelector('input[name="slug"]') as HTMLInputElement).value }),
    })
      .then((res) => (res.ok ? res.json() : null))
      .then((data: { token?: string } | null) => {
        if (data && typeof data.token === "string" && data.token) tokenInput.value = data.token;
      })
      .catch(() => {});

    requestAnimationFrame(tick);
  };

  // Mulai timer hanya saat modal dibuka jika berada di dalam modal/dialog
  const isInModal = Boolean(form.closest("[role='dialog'], #ritual-modal, .ritual-modal-card"));
  if (isInModal) {
    window.addEventListener("reward-modal:open", startTimer, { once: true });
  } else {
    startTimer();
  }

  // Task 2.16 / 02-U9: pesan kesalahan interaktif ditulis ke #form-error
  const errEl = document.getElementById("form-error") as HTMLElement;
  const showError = (msg: string) => {
    errEl.textContent = msg;
    errEl.hidden = false;
  };
  const clearError = () => {
    errEl.hidden = true;
    errEl.textContent = "";
  };
  const emailEl = document.getElementById("email") as HTMLInputElement;
  emailEl.addEventListener("input", clearError);

  // Guard double-submit (task 02-U2)
  let isSubmitting = false;
  form.addEventListener("submit", (e) => {
    if (!tokenInput.value || isSubmitting) {
      e.preventDefault();
      return;
    }
    if (!unlocked) {
      e.preventDefault();
      showError(copy.tooFast);
      return;
    }
    if (!form.checkValidity()) {
      e.preventDefault();
      showError(emailEl.validity.typeMismatch ? copy.errorEmail : copy.errorGeneric);
      return;
    }
    clearError();
    isSubmitting = true;
    const originalText = btnText.textContent;
    btn.disabled = true;
    btn.setAttribute("aria-disabled", "true");
    btn.style.cursor = "wait";
    btn.style.opacity = "0.7";
    btnText.textContent = copy.submitting;
    setTimeout(() => {
      isSubmitting = false;
      btn.disabled = false;
      btn.removeAttribute("aria-disabled");
      btn.style.cursor = "pointer";
      btn.style.opacity = "1";
      btnText.textContent = originalText;
    }, 8000);
  });
</script>

<style>
  .claim-form {
    position: relative;
  }

  .timer-panel {
    color: var(--color-ink);
    background: var(--color-gold-subtle);
    border: 1px solid rgba(217, 144, 32, 0.2);
    border-radius: var(--radius-control);
    padding: 10px 14px;
    font-variant-numeric: tabular-nums;
    margin: 0;
    font-size: 13px;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    transition: background 220ms ease, border-color 220ms ease;
  }

  .timer-panel.unlocked {
    background: var(--color-success-subtle);
    border-color: rgba(35, 122, 85, 0.25);
    color: #114c35;
  }

  .timer-icon {
    flex-shrink: 0;
    color: var(--color-gold);
  }

  .timer-panel.unlocked .timer-icon {
    color: var(--color-success);
  }

  .timer-track {
    height: 4px;
    background: var(--color-border);
    border-radius: var(--radius-pill);
    margin: 8px 0 16px;
    overflow: hidden;
  }

  .timer-bar {
    height: 100%;
    width: 0%;
    background: var(--color-primary);
    border-radius: var(--radius-pill);
    transition: width 220ms cubic-bezier(0.2, 0.8, 0.2, 1), background-color 220ms ease;
  }

  .timer-bar.unlocked {
    background: var(--color-success);
  }

  .field-label {
    display: block;
    font-weight: var(--font-weight-semibold);
    color: var(--color-ink);
    font-size: 13px;
    margin-bottom: 6px;
  }

  .email-input {
    width: 100%;
    min-height: 44px;
    border: var(--border-default);
    border-radius: var(--radius-control);
    padding: 0 14px;
    font-size: 15px;
    background: var(--color-surface-raised);
    color: var(--color-ink);
    font-family: inherit;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }

  .email-input::placeholder {
    color: var(--color-text-muted);
    opacity: 0.65;
  }

  .email-input:focus {
    border-color: var(--color-primary);
    box-shadow: var(--focus-ring);
    outline: none;
  }

  .form-error-alert {
    background: var(--color-danger-subtle);
    color: var(--color-danger);
    border: 1px solid rgba(181, 60, 74, 0.2);
    border-radius: var(--radius-control);
    padding: var(--space-3);
    margin-top: var(--space-3);
    font-size: var(--text-body-sm);
  }

  .consent-text {
    font-size: 12px;
    color: var(--color-text-muted);
    margin: 10px 0 0;
    line-height: 1.45;
  }

  .consent-text a {
    text-decoration: underline;
    color: var(--color-info);
    text-underline-offset: 2px;
  }

  .resubscribe-label {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin-top: 8px;
    font-size: 12px;
    color: var(--color-text-muted);
    cursor: pointer;
    line-height: 1.45;
  }

  .resubscribe-checkbox {
    margin-top: 2px;
    width: 15px;
    height: 15px;
    accent-color: var(--color-primary);
    flex-shrink: 0;
    cursor: pointer;
  }

  .submit-cta-btn {
    width: 100%;
    min-height: 46px;
    margin-top: 16px;
    border: 1px solid transparent;
    border-radius: var(--radius-control);
    background: var(--color-surface-subtle);
    color: var(--color-text-muted);
    font-weight: var(--font-weight-semibold);
    font-size: 15px;
    cursor: not-allowed;
    font-family: inherit;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    transition: background-color 200ms ease, color 200ms ease, transform 100ms ease, box-shadow 150ms ease;
  }

  .submit-cta-btn.active {
    background: var(--color-primary);
    color: var(--color-surface-raised);
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(23, 107, 91, 0.25);
  }

  .submit-cta-btn.active:hover {
    background: var(--color-primary-hover);
    box-shadow: 0 4px 12px rgba(23, 107, 91, 0.35);
  }

  .submit-cta-btn.active:active {
    transform: translateY(1px);
  }

  .submit-cta-btn:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }
</style>
