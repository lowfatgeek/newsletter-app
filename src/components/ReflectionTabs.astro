---
import { type Locale, t } from "../lib/i18n";

interface Props {
  muslimText: string;
  universalText: string;
  locale: Locale;
}
const { muslimText, universalText, locale } = Astro.props;
const heading = t(locale, "reflectionHeading");
const tab1 = t(locale, "tabMuslim");
const tab2 = t(locale, "tabUniversal");
---
<section style="background: var(--color-surface-raised); border: var(--border-default); border-radius: var(--radius-card); padding: var(--space-6); margin-top: var(--space-8); box-shadow: var(--shadow-card);">
  <h2 style="color: var(--color-ink); font-size: var(--text-h3); margin: 0; line-height: 1.3; font-weight: var(--font-weight-semibold);">{heading}</h2>
  <div role="tablist" aria-label={heading} class="tab-track">
    <button
      type="button"
      role="tab"
      id="tab-muslim"
      aria-selected="true"
      aria-controls="panel-muslim"
      class="tab-btn"
    >{tab1}</button>
    <button
      type="button"
      role="tab"
      id="tab-universal"
      aria-selected="false"
      aria-controls="panel-universal"
      tabindex="-1"
      class="tab-btn"
    >{tab2}</button>
  </div>
  <div
    role="tabpanel"
    id="panel-muslim"
    aria-labelledby="tab-muslim"
    tabindex="0"
    style="font-size: var(--text-body-lg); line-height: 1.7; color: var(--color-text);"
  >{muslimText}</div>
  <div
    role="tabpanel"
    id="panel-universal"
    aria-labelledby="tab-universal"
    tabindex="0"
    hidden
    style="font-size: var(--text-body-lg); line-height: 1.7; color: var(--color-text);"
  >{universalText}</div>
</section>

<style>
  .tab-track {
    display: flex;
    gap: var(--space-1);
    background: var(--color-surface-subtle);
    border: 1px solid rgba(231, 222, 208, 0.8);
    border-radius: var(--radius-control);
    padding: 4px;
    margin: var(--space-5) 0;
    width: 100%;
    max-width: 440px;
  }

  .tab-btn {
    flex: 1;
    min-height: 44px;
    padding: 8px 16px;
    border-radius: calc(var(--radius-control) - 4px);
    border: none;
    background: transparent;
    color: var(--color-text);
    font-size: var(--text-body);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    font-family: inherit;
    transition: background 160ms cubic-bezier(0.2, 0.8, 0.2, 1),
                color 160ms cubic-bezier(0.2, 0.8, 0.2, 1),
                box-shadow 160ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .tab-btn:hover:not([aria-selected="true"]) {
    color: var(--color-ink);
  }

  .tab-btn[aria-selected="true"] {
    background: var(--color-surface-raised);
    color: var(--color-primary);
    box-shadow: 0 2px 6px rgba(21, 59, 53, 0.08), 0 1px 2px rgba(21, 59, 53, 0.04);
  }

  .tab-btn:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }
</style>

<script>
  function setupTabs(root: Document) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"][id^="tab-muslim"], [role="tab"][id^="tab-universal"]')];
    if (tabs.length === 0) return;
    const select = (tab: HTMLButtonElement, focus = true) => {
      tabs.forEach((b) => {
        const selected = b === tab;
        b.setAttribute("aria-selected", String(selected));
        b.tabIndex = selected ? 0 : -1;
        const panel = root.getElementById(b.getAttribute("aria-controls") || "");
        if (panel) panel.hidden = !selected;
      });
      if (focus) tab.focus();
    };
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => select(tab, false));
      tab.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
        e.preventDefault();
        const next = tabs[(tabs.indexOf(tab) + (e.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length];
        select(next);
      });
    });
  }
  setupTabs(document);
</script>
