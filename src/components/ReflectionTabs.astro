---
import { type Locale, t } from "../lib/i18n";

interface Props {
  muslimText: string;
  universalText: string;
  locale: Locale;
  embedded?: boolean;
}
const { muslimText, universalText, locale, embedded = true } = Astro.props;
const heading = t(locale, "reflectionHeading");
const tab1 = t(locale, "tabMuslim");
const tab2 = t(locale, "tabUniversal");
---
<section class:list={["reflection-section", { "standalone-card": !embedded }]}>
  <span class="ritual-header-badge">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    <span>{locale === "en" ? "Step 1: Take A Quiet Moment" : "Langkah 1: Luangkan Waktu Sejenak"}</span>
  </span>
  <h2 class="reflection-heading">{heading}</h2>
  <div role="tablist" aria-label={heading} class="editorial-tablist">
    <button
      type="button"
      role="tab"
      id="tab-muslim"
      aria-selected="true"
      aria-controls="panel-muslim"
      class="editorial-tab"
    >
      <span class="tab-icon-wrap" aria-hidden="true">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
          <path d="M20 3v4"/>
          <path d="M22 5h-4"/>
        </svg>
      </span>
      <span>{tab1}</span>
    </button>
    <button
      type="button"
      role="tab"
      id="tab-universal"
      aria-selected="false"
      aria-controls="panel-universal"
      tabindex="-1"
      class="editorial-tab"
    >
      <span class="tab-icon-wrap" aria-hidden="true">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
          <path d="M5 3v4"/>
          <path d="M19 17v4"/>
          <path d="M3 5h4"/>
          <path d="M17 19h4"/>
        </svg>
      </span>
      <span>{tab2}</span>
    </button>
  </div>
  <div
    role="tabpanel"
    id="panel-muslim"
    aria-labelledby="tab-muslim"
    class="prayer-panel"
  >{muslimText}</div>
  <div
    role="tabpanel"
    id="panel-universal"
    aria-labelledby="tab-universal"
    hidden
    class="prayer-panel"
  >{universalText}</div>
</section>

<style>
  .reflection-section.standalone-card {
    background: var(--color-surface-raised);
    border: var(--border-default);
    border-radius: var(--radius-card);
    padding: var(--space-6);
    margin-top: var(--space-8);
    box-shadow: var(--shadow-card);
  }

  .ritual-header-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-primary);
    background: var(--color-primary-subtle);
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    margin-bottom: var(--space-2);
  }

  .reflection-heading {
    color: var(--color-ink);
    font-size: 1.25rem;
    margin: 0;
    line-height: 1.3;
    font-weight: var(--font-weight-semibold);
    letter-spacing: -0.015em;
  }

  .editorial-tablist {
    display: flex;
    gap: var(--space-5);
    border-bottom: 1px solid var(--color-border);
    margin: var(--space-3) 0 var(--space-4);
  }

  .editorial-tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 40px;
    padding: 8px 2px;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    color: var(--color-text-muted);
    font-size: var(--text-body-sm);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    font-family: inherit;
    white-space: nowrap;
    transition: color 160ms cubic-bezier(0.2, 0.8, 0.2, 1),
                border-color 160ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .editorial-tab:hover:not([aria-selected="true"]) {
    color: var(--color-ink);
    border-bottom-color: rgba(21, 59, 53, 0.25);
  }

  .editorial-tab[aria-selected="true"] {
    color: var(--color-primary);
    border-bottom: 2px solid var(--color-primary);
  }

  .tab-icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .tab-icon-wrap svg {
    width: 16px;
    height: 16px;
    display: block;
    transition: color 160ms cubic-bezier(0.2, 0.8, 0.2, 1),
                transform 160ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .editorial-tab[aria-selected="true"] .tab-icon-wrap svg {
    color: var(--color-primary);
  }

  .editorial-tab[aria-selected="false"] .tab-icon-wrap svg {
    color: var(--color-text-muted);
    opacity: 0.85;
  }

  .editorial-tab:hover:not([aria-selected="true"]) .tab-icon-wrap svg {
    color: var(--color-ink);
    opacity: 1;
  }

  .editorial-tab:focus-visible {
    outline: none;
    border-radius: 4px;
    box-shadow: var(--focus-ring);
  }

  .prayer-panel {
    font-size: 0.9375rem;
    line-height: 1.62;
    color: var(--color-text);
    max-width: 58ch;
  }
</style>

<script>
  function setupTabs(root: Document) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"][id^="tab-muslim"], [role="tab"][id^="tab-universal"]')];
    if (tabs.length === 0) return;
    const select = (tab: HTMLButtonElement, focus = true) => {
      tabs.forEach((b) => {
        const selected = b === tab;
        b.setAttribute("aria-selected", String(selected));
        b.tabIndex = selected ? 0 : -1;
        const panel = root.getElementById(b.getAttribute("aria-controls") || "");
        if (panel) panel.hidden = !selected;
      });
      if (focus) tab.focus();
    };
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => select(tab, false));
      tab.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
        e.preventDefault();
        const next = tabs[(tabs.indexOf(tab) + (e.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length];
        select(next);
      });
    });
  }
  setupTabs(document);
</script>
